# Deployment-specific config supplied by the operator's own inventory repo and
# mounted via HA_DASHBOARD / HA_AUTOMATIONS / HA_PACKAGES / RVC_INSTANCE_MAP.
# Only the *.example.* counterparts belong in this repo (ADR-012).
deploy/coach/config/rvc-instances.yml
deploy/coach/config/homeassistant/coach-overview.yaml
deploy/coach/config/homeassistant/automations.yaml
deploy/coach/config/homeassistant/energy_prefs.json
deploy/coach/config/homeassistant/packages/*
!deploy/coach/config/homeassistant/packages/.gitkeep
