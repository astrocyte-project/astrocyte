# Coach node environment — copy to .env and fill in.
# Secrets never enter git; the runbook covers generating each value.

# --- Identity ---------------------------------------------------------------
# Everything that names or addresses THIS deployment belongs here, and nowhere
# else. No file under deploy/coach/ should carry a real hostname, address or
# coach id: values baked into a shipped file can only be corrected by editing
# it on the node, which is what silently forks the node from the repo.
COACH_ID=refcoach
TZ=America/New_York

# --- Astrocyte API (ADR-014 interim auth) ------------------------------------
# The tailnet IP of the Pi (tailscale ip -4). NEVER 0.0.0.0 on the coach LAN.
ASTROCYTE_API_HOST=127.0.0.1
# openssl rand -hex 32
ASTROCYTE_API_TOKEN=

# --- Home Assistant -----------------------------------------------------------
# Long-lived access token: HA profile -> Security -> Long-lived access tokens.
ASTROCYTE_HA_TOKEN=

# --- PostgreSQL (HA recorder + NextCloud) --------------------------------------
POSTGRES_USER=astrocyte
POSTGRES_PASSWORD=
POSTGRES_DB=homeassistant

# --- MQTT ---------------------------------------------------------------------
# Must match config/mosquitto.conf (mosquitto_passwd). Empty = anonymous (dev).
MQTT_USERNAME=
MQTT_PASSWORD=

# --- RV-C bridge ---------------------------------------------------------------
ASTROCYTE_RVC_CAN_CHANNEL=can0
ASTROCYTE_RVC_CAN_INTERFACE=socketcan
# SAFETY: flip to false only after on-vehicle validation (see the runbook).
ASTROCYTE_RVC_LISTEN_ONLY=true
# The coach instance→device map (named HA lights from their COMMAND_2 instance)
# is mounted by compose at /app/config/rvc-instances.yml; no env needed. Edit
# deploy/coach/config/rvc-instances.yml to name fixtures (#122).

# --- Optional profiles -----------------------------------------------------------
# docker compose --profile apps up -d
NEXTCLOUD_BIND=127.0.0.1
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# --- Image ----------------------------------------------------------------------
# Pinned release tag; bump deliberately when upgrading the coach.
ASTROCYTE_IMAGE=ghcr.io/astrocyte-project/astrocyte:0.3.0

# --- Observability (--profile observability) ---------------------------------
# Grafana admin login. VictoriaMetrics reuses ASTROCYTE_HA_TOKEN (above) to
# scrape HA's /api/prometheus exporter, so no extra secret is needed there.
GRAFANA_USER=admin
# openssl rand -hex 16
GRAFANA_PASSWORD=

# This deployment's router, as host:port, substituted into scrape.yml. The
# metrics keep the canonical label host="coach-router" whatever the box is
# called locally — the WAN dashboard queries that label, so do not localise it.
COACH_ROUTER_ADDR=192.0.2.1:9100
# Long-term metrics store that vmagent fans samples out to, as host:port. Its
# queue is independent of the local one, so this being unreachable never affects
# local monitoring. A deployment without a second store should drop the extra
# -remoteWrite.url from the vmagent service rather than point it somewhere dead.
VM_LONGTERM_ADDR=192.0.2.21:8428

# --- WAN gateway poller (systemd user timer, runbook §7) ----------------------
# Not read by compose: the poller runs on the host. Put this in
# ~/.config/coach-gw-metrics.env, which its unit reads.
#   COACH_ROUTER_URL=https://<router mgmt addr>
